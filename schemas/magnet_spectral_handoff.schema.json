{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FusionSandwich/parastell/schemas/magnet_spectral_handoff.schema.json",
  "title": "ParaStell magnet spectral handoff configuration",
  "description": "Configuration for OpenMC magnet-interface tallies and deterministic HTS phase-space export.",
  "type": "object",
  "required": ["regions"],
  "oneOf": [
    {
      "required": ["energy_bounds_eV"],
      "not": {
        "anyOf": [
          {"required": ["energy_group_structure"]},
          {"required": ["energy_group_file"]}
        ]
      }
    },
    {
      "required": ["energy_group_structure"],
      "not": {
        "anyOf": [
          {"required": ["energy_bounds_eV"]},
          {"required": ["energy_group_file"]}
        ]
      }
    },
    {
      "required": ["energy_group_file"],
      "not": {
        "anyOf": [
          {"required": ["energy_bounds_eV"]},
          {"required": ["energy_group_structure"]}
        ]
      }
    }
  ],
  "properties": {
    "energy_bounds_eV": {
      "$ref": "#/$defs/nonnegativeEdges"
    },
    "energy_group_structure": {
      "type": "string",
      "minLength": 1,
      "description": "Key in openmc.mgxs.GROUP_STRUCTURES."
    },
    "energy_group_file": {"type": "string", "minLength": 1},
    "energy_group_units": {
      "type": "string",
      "enum": ["eV", "keV", "MeV"],
      "default": "eV"
    },
    "particles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "default": ["neutron", "photon"]
    },
    "mu_bounds": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "number", "minimum": -1.0, "maximum": 1.0},
      "default": [-1.0, 0.0, 1.0]
    },
    "mu_bins": {"type": "integer", "minimum": 1},
    "time_bounds_s": {
      "$ref": "#/$defs/nonnegativeEdges"
    },
    "source_definition": {
      "type": "object",
      "additionalProperties": true
    },
    "source_definition_hash": {
      "type": "string",
      "minLength": 1
    },
    "dagmc_geometry_hash": {
      "type": "string",
      "minLength": 1
    },
    "dagmc_geometry_path": {"type": "string", "minLength": 1},
    "parastell_git_sha": {"type": "string", "minLength": 7},
    "openmc_git_sha": {"type": "string", "minLength": 7},
    "run_statistics": {
      "type": "object",
      "additionalProperties": true
    },
    "polar_bounds_rad": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 3.141592653589793
      }
    },
    "azimuthal_bounds_rad": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "number",
        "minimum": -3.141592653589793,
        "maximum": 3.141592653589793
      }
    },
    "tally_id_base": {
      "type": "integer",
      "minimum": 1,
      "default": 9000000
    },
    "normalization": {
      "type": "object",
      "properties": {
        "source_rate_per_s": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "tallies": {
      "type": "object",
      "properties": {
        "cell_flux": {"type": "boolean", "default": true},
        "mesh_flux": {"type": "boolean", "default": true},
        "boundary_current": {"type": "boolean", "default": true},
        "heating": {"type": "boolean", "default": true},
        "damage_energy": {"type": "boolean", "default": true},
        "gas_production": {
          "oneOf": [
            {"type": "boolean"},
            {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          ],
          "default": false
        }
      },
      "additionalProperties": false
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/region"}
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonnegativeEdges": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "number", "minimum": 0.0}
    },
    "numericEdges": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "number"}
    },
    "positiveIdArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "positiveIdMap": {
      "type": "object",
      "patternProperties": {
        "^[1-9][0-9]*$": {"type": "number", "exclusiveMinimum": 0.0}
      },
      "additionalProperties": false
    },
    "coordinateFrame": {
      "type": "object",
      "properties": {
        "origin_cm": {"$ref": "#/$defs/vector3"},
        "x_axis": {"$ref": "#/$defs/vector3"},
        "y_axis": {"$ref": "#/$defs/vector3"},
        "z_axis": {"$ref": "#/$defs/vector3"},
        "labels": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "regularMesh": {
      "type": "object",
      "required": ["kind", "lower_left_cm", "upper_right_cm", "dimension"],
      "properties": {
        "kind": {"const": "regular"},
        "lower_left_cm": {"$ref": "#/$defs/vector3"},
        "upper_right_cm": {"$ref": "#/$defs/vector3"},
        "dimension": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "integer", "minimum": 1}
        },
        "mesh_id": {"type": "integer", "minimum": 1},
        "name": {"type": "string"}
      },
      "additionalProperties": false
    },
    "unstructuredMesh": {
      "type": "object",
      "required": ["kind", "filename"],
      "properties": {
        "kind": {"const": "unstructured"},
        "filename": {"type": "string", "minLength": 1},
        "library": {
          "type": "string",
          "enum": ["moab", "libmesh"],
          "default": "moab"
        },
        "mesh_id": {"type": "integer", "minimum": 1},
        "name": {"type": "string"}
      },
      "additionalProperties": false
    },
    "couplingPlane": {
      "type": "object",
      "required": [
        "id",
        "role",
        "surface_id",
        "placement",
        "extent",
        "spatial_bins"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "role": {"type": "string", "enum": ["entry", "exit", "diagnostic"]},
        "surface_id": {"type": "integer", "minimum": 1},
        "magnet_region_id": {"type": ["string", "integer"]},
        "magnet_component": {"type": "string", "minLength": 1},
        "placement": {
          "type": "object",
          "required": ["mode", "origin_cm", "normal", "reference_direction"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["explicit", "magnet_attached", "first_wall_proxy"]
            },
            "origin_cm": {"$ref": "#/$defs/vector3"},
            "normal": {"$ref": "#/$defs/vector3"},
            "reference_direction": {"$ref": "#/$defs/vector3"}
          },
          "additionalProperties": true
        },
        "extent": {
          "type": "object",
          "required": ["width_cm", "height_cm"],
          "properties": {
            "width_cm": {"type": "number", "exclusiveMinimum": 0.0},
            "height_cm": {"type": "number", "exclusiveMinimum": 0.0}
          },
          "additionalProperties": false
        },
        "spatial_bins": {
          "type": "object",
          "required": ["u", "v"],
          "properties": {
            "u": {
              "oneOf": [
                {"type": "integer", "minimum": 1},
                {"$ref": "#/$defs/numericEdges"}
              ]
            },
            "v": {
              "oneOf": [
                {"type": "integer", "minimum": 1},
                {"$ref": "#/$defs/numericEdges"}
              ]
            }
          },
          "additionalProperties": false
        },
        "geometry_source": {"type": "object", "additionalProperties": true},
        "association": {"type": "object", "additionalProperties": true},
        "mu_tolerance": {"type": "number", "minimum": 0.0, "exclusiveMaximum": 1.0},
        "adjacency_tolerance_cm": {"type": "number", "minimum": 0.0},
        "proxy": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "region": {
      "type": "object",
      "required": ["name", "cell_ids"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "region_id": {"type": ["string", "integer", "null"]},
        "source_region_id": {"type": ["string", "integer", "null"]},
        "magnet_id": {"type": ["string", "integer", "null"]},
        "coil_id": {"type": ["string", "integer", "null"]},
        "winding_pack_id": {"type": ["string", "integer", "null"]},
        "magnet_component": {"type": ["string", "null"]},
        "geometry_source_mode": {
          "type": "string",
          "enum": ["production", "legacy_surface", "first_wall_proxy"]
        },
        "coupling_planes": {
          "type": "array",
          "items": {"$ref": "#/$defs/couplingPlane"}
        },
        "entry_surface_id": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "exit_surface_id": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "units": {"type": "string", "default": "cm"},
        "cell_ids": {"$ref": "#/$defs/positiveIdArray"},
        "surface_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "phase_space_cell_id": {"type": "integer", "minimum": 1},
        "volume_cm3": {"type": "number", "exclusiveMinimum": 0.0},
        "cell_volumes_cm3": {"$ref": "#/$defs/positiveIdMap"},
        "surface_areas_cm2": {"$ref": "#/$defs/positiveIdMap"},
        "surface_normal_signs": {
          "type": "object",
          "patternProperties": {
            "^[1-9][0-9]*$": {"type": "integer", "enum": [-1, 1]}
          },
          "additionalProperties": false
        },
        "surface_outward_normals_global": {
          "type": "object",
          "patternProperties": {
            "^[1-9][0-9]*$": {"$ref": "#/$defs/vector3"}
          },
          "additionalProperties": false
        },
        "coordinate_frame": {"$ref": "#/$defs/coordinateFrame"},
        "mesh": {
          "oneOf": [
            {"$ref": "#/$defs/regularMesh"},
            {"$ref": "#/$defs/unstructuredMesh"}
          ]
        },
        "damage_nuclides": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}
